{
  "name": "@cleanfield/node",
  "version": "0.1.8",
  "description": "CleanField real-time speech enhancement engine for Node.js: prebuilt native addon, no node-gyp.",
  "license": "MIT",
  "author": "CleanField",
  "repository": { "type": "git", "url": "git+https://github.com/CleanfieldVoice/Cleanfield.git", "directory": "packages/node" },
  "main": "index.js",
  "types": "index.d.ts",
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "files": [
    "index.js",
    "index.d.ts",
    "scripts/",
    
    "models/voice-default.cfwm"
  ],
  "scripts": {
    "prepack": "node scripts/prepare-model.mjs",
    "postinstall": "node scripts/fetch-prebuilt.mjs",
    "test": "node test/smoke.js"
  },
  "optionalDependencies": {
    "@cleanfield/node-win32-x64": "0.1.8",
    "@cleanfield/node-win32-arm64": "0.1.8",
    "@cleanfield/node-darwin-universal": "0.1.8",
    "@cleanfield/node-linux-x64": "0.1.8",
    "@cleanfield/node-linux-arm64": "0.1.8"
  },
  "cleanfield": {
    "releaseBaseUrl": "https://github.com/CleanfieldVoice/Cleanfield/releases/download",
    "model": "models/voice-default.cfwm"
  },
  "keywords": [
    "audio",
    "speech-enhancement",
    "denoise",
    "wasm",
    "native-addon"
  ]
}







